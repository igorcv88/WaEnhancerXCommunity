<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Patch/minor WhatsApp versions are deliberately not allowlisted here. On every Android
      version supported by this module (minSdk 28), 2.x hosts enter the runtime compatibility
      path. HostCompatibility then resolves the semantic DexKit anchors against the installed APK
      before any Feature is allowed to install hooks, and FeatureLoader continues to isolate and
      report feature-specific hook failures.

      The default arrays.xml entries are retained as historical validated families and as a
      fallback for resource tooling, but they are not the runtime compatibility proof on a
      supported device.
    -->
    <string-array name="supported_versions_wpp">
        <item>2</item>
    </string-array>

    <string-array name="supported_versions_business">
        <item>2</item>
    </string-array>
</resources>
