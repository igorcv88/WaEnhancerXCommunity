<?xml version="1.0" encoding="utf-8"?>
<!--
  Live preview for the floating bottom bar editor.

  Ported from the upstream WaEnhancerX layout (activity_bottom_bar_customization.xml) so the
  editor shows the bar against a mock WhatsApp screen with the real tab icons and labels,
  instead of the hand-rolled placeholder this fork used to build in code.

  The colours are the WhatsApp dark palette on purpose: the preview mimics WhatsApp, not the
  module's own theme, so what the user sees here matches what lands in the host app.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="270dp"
    app:cardCornerRadius="0dp"
    app:cardElevation="8dp"
    app:strokeWidth="0dp">

    <RelativeLayout
        android:id="@+id/preview_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0b141a">

        <!-- Mock WhatsApp header -->
        <LinearLayout
            android:id="@+id/preview_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#121b22"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WhatsApp"
                android:textColor="#e9edef"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@null"
                android:src="@drawable/camera"
                app:tint="#8696a0" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="#8696a0" />
        </LinearLayout>

        <!-- Mock chat list -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/preview_header"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="#182229"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.1"
                    android:text="@string/bottom_bar_preview_disclaimer"
                    android:textColor="#8696a0"
                    android:textSize="10sp" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bottom_bar_preview_chat_name"
                        android:textColor="#e9edef"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/bottom_bar_preview_chat_message"
                        android:textColor="#8696a0"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/bottom_bar_preview_chat_time"
                    android:textColor="#8696a0"
                    android:textSize="10sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Mock floating action button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/preview_fab"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="90dp"
            app:cardBackgroundColor="#00a884"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/preview_fab_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_fab_new_chat"
                app:tint="#111b21" />
        </com.google.android.material.card.MaterialCardView>

        <!-- The floating pill itself -->
        <FrameLayout
            android:id="@+id/preview_pill_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">

            <LinearLayout
                android:id="@+id/preview_bottom_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="22dp"
                android:elevation="6dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:id="@+id/preview_tab_chats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <!--
                      WhatsApp's own active-tab pill. This is the host app's indicator, drawn
                      here so the mock looks like the real screen. The module no longer draws
                      an indicator of its own.
                    -->
                    <FrameLayout
                        android:id="@+id/preview_active_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/wa_active_indicator"
                        android:paddingHorizontal="20dp">

                        <ImageView
                            android:id="@+id/preview_icon_chats"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_tab_chats"
                            app:tint="#00a884" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/preview_label_chats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/bottom_bar_preview_tab_chats"
                        android:textColor="#e9edef"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/preview_tab_updates"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/preview_icon_updates"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tab_updates"
                        app:tint="#8696a0" />

                    <TextView
                        android:id="@+id/preview_label_updates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bottom_bar_preview_tab_updates"
                        android:textColor="#8696a0"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/preview_tab_communities"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/preview_icon_communities"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tab_communities"
                        app:tint="#8696a0" />

                    <TextView
                        android:id="@+id/preview_label_communities"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bottom_bar_preview_tab_communities"
                        android:textColor="#8696a0"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/preview_tab_calls"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/preview_icon_calls"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tab_calls"
                        app:tint="#8696a0" />

                    <TextView
                        android:id="@+id/preview_label_calls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bottom_bar_preview_tab_calls"
                        android:textColor="#8696a0"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
