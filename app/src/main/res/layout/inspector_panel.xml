<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inspector_panel_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#F7F8FA"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@android:style/Theme.Material.Light.NoActionBar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Identity block -->
        <TextView
            android:id="@+id/inspector_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="14sp"
            tools:text="conversations_row_contact_name" />

        <TextView
            android:id="@+id/inspector_class"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            tools:text="com.whatsapp.TextEmojiLabel" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#D0D4D8" />

        <!-- Geometry block -->
        <TextView
            android:id="@+id/inspector_geometry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            tools:text="stability=STABLE  targetsAncestor=false" />

        <TextView
            android:id="@+id/inspector_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp"
            tools:text=".ConversationActivity #conversations_row_contact_name" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="#D0D4D8" />

        <!-- Context block -->
        <TextView
            android:id="@+id/inspector_context_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            tools:text="contentDescription: ‹redigido›" />

        <TextView
            android:id="@+id/inspector_reveal_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/inspector_reveal"
            android:textColor="#1D6BBD"
            android:visibility="gone" />

        <TextView
            android:id="@+id/inspector_parent_chain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            tools:text="parents: conversation_row &gt; conversations_view &gt; content" />

        <!-- Actions -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <Button
                android:id="@+id/inspector_action_copy_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inspector_action_copy_id" />

            <Button
                android:id="@+id/inspector_action_copy_class"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inspector_action_copy_class" />

            <Button
                android:id="@+id/inspector_action_copy_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inspector_action_copy_selector" />

            <Button
                android:id="@+id/inspector_action_add_css"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inspector_action_add_css" />

            <Button
                android:id="@+id/inspector_action_parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inspector_action_parent" />

            <Button
                android:id="@+id/inspector_action_child"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inspector_action_child" />

            <Button
                android:id="@+id/inspector_action_exit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inspector_action_exit" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

</LinearLayout>
