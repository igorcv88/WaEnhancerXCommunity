<!--
  Host-process twin of ic_chevron_right.

  ic_chevron_right fills with ?attr/colorPrimary, which is correct inside the module's own
  activities but resolves to transparent when the drawable is inflated in the WhatsApp process
  with a null theme. This copy uses a literal colour so the caller can tint it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M10,6L8.59,7.41 13.17,12l-4.58,4.59L10,18l6,-6z" />
</vector>
