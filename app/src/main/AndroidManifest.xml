<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        android:minSdkVersion="33" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.lsposed.manager" />
        <package android:name="io.github.lsposed.manager" />
        <package android:name="org.meowcat.edxposed.manager" />
        <package android:name="com.solohsu.android.edxp.manager" />
        <package android:name="de.robv.android.xposed.installer" />
        <package android:name="me.weishu.exp" />
    </queries>

    <application
        android:forceQueryable="true"
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        tools:targetApi="30">

        <!--
            Exported because automation apps must be able to reach it. The request itself is
            authenticated by the per-installation token checked in the receiver; a broadcast
            carries no caller identity, so no manifest-level permission can express this.
            The action is namespaced to the installed application ID; the pre-rebrand action is
            still accepted for one release so existing automation profiles keep working.
        -->
        <receiver
            android:name=".receivers.TaskerMessageSentReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.MESSAGE_SENT" />
                <action android:name="com.waenhancer.MESSAGE_SENT" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".provider.DeletedMessagesProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true" />

        <activity
            android:name=".xposed.features.others.EmbeddedSettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="com.whatsapp"
            android:theme="@style/Theme.AppCompat.DayNight" />

        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.App.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/noexist" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.AboutActivity" android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.DiagnosticsActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/AppTheme" />
        <activity android:name=".activities.TextEditorActivity" android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.ContactPickerActivity"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.CallRecordingSettingsActivity"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.BottomBarCustomizationActivity"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.RecordingsActivity"
            android:exported="true"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.StatusForwardRulesActivity"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/NoActionBarTheme" />
        <activity
            android:name=".activities.FilterItemsActivity"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/NoActionBarTheme" />
        <activity
            android:name=".activities.SearchActivity"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activities.DeletedMessagesActivity"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.MessageListActivity"
            android:parentActivityName=".activities.DeletedMessagesActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.ChangelogActivity"
            android:exported="true"
            android:label="@string/changelog_title"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.UpdateSettingsActivity"
            android:label="@string/update_settings"
            android:parentActivityName=".activities.ChangelogActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.ReleaseDetailsActivity"
            android:exported="false"
            android:label="Release Details"
            android:parentActivityName=".activities.ChangelogActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.TaskerGuideActivity"
            android:label="Automation Guide"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.TaskerHistoryActivity"
            android:label="Automation History"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".ui.fragments.SupportedVersionsActivity"
            android:exported="true"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".activities.ForceStartActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <service
            android:name=".xposed.bridge.service.BridgeService"
            android:exported="true"
            tools:ignore="ExportedService" />

        <service
            android:name=".services.GhostModeTileService"
            android:exported="true"
            android:icon="@drawable/ghost_enabled"
            android:label="@string/ghost_mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".services.DndModeTileService"
            android:exported="true"
            android:icon="@drawable/airplane_enabled"
            android:label="@string/dnd_mode_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".services.FreezeLastSeenTileService"
            android:exported="true"
            android:icon="@drawable/eye_enabled"
            android:label="@string/freezelastseen"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".services.StealthReadTicksTileService"
            android:exported="true"
            android:icon="@drawable/eye_disabled"
            android:label="@string/hideread"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".services.StealthStatusViewingTileService"
            android:exported="true"
            android:icon="@drawable/preview_eye"
            android:label="@string/hidestatusview"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".services.AlwaysOnlineTileService"
            android:exported="true"
            android:icon="@drawable/online"
            android:label="@string/always_online"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".services.ProximitySensorSwitchTileService"
            android:exported="true"
            android:icon="@drawable/ic_media"
            android:label="@string/disable_audio_sensor"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".services.BlockCallsTileService"
            android:exported="true"
            android:icon="@drawable/deleted"
            android:label="@string/call_blocker"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".services.ContactOnlineNotificationsTileService"
            android:exported="true"
            android:icon="@drawable/ic_notifications_black_24dp"
            android:label="@string/show_toast_on_contact_online"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service
            android:name=".services.HideDeliveredTileService"
            android:exported="true"
            android:icon="@drawable/eye_disabled"
            android:label="@string/hidereceipt"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".xposed.bridge.providers.HookProvider"
            android:authorities="${applicationId}.hookprovider"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="@string/app_desc" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedsharedprefs" android:value="true" />
        <meta-data android:name="xposedscope" android:resource="@array/scope" />

        <receiver
            android:name=".receivers.WAFReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.facebook.GET_PHONE_ID" />
                <action android:name="android.support.customtabs.action.CustomTabsService" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
